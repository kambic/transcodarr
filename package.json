{
  "dependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@videojs/hlsjs-video": "^10.0.0-rc.1",
    "@videojs/html": "^10.0.0-rc.1",
    "alpinejs": "^3.17.2",
    "flowbite": "^4.0.2",
    "htmx.org": "2.0.10",
    "tailwindcss": "^4.3.3"
  },
  "scripts": {
"build:css": "bunx @tailwindcss/cli -i ./static/src/input.css -o ./static/dist/app.css --minify",
    "watch:css": "bunx @tailwindcss/cli -i ./static/src/input.css -o ./static/dist/app.css --watch",
    "build:js": "bun build ./static/src/main.js ./static/src/js/video-player.js --outdir=./static/dist --format=esm --minify",
    "watch:js": "bun build ./static/src/main.js ./static/src/js/video-player.js --outdir=./static/dist --format=esm --watch",
    "build": "bun run build:css && bun run build:js",
    "watch": "bun run --parallel watch:css watch:js"
  }
}