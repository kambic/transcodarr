// Project-local debug tasks
//
// For more documentation on how to configure debug tasks,
// see: https://zed.dev/docs/debugger
[
	{
		"label": "Python Active File",
		"adapter": "Debugpy",
		"program": "$ZED_FILE",
		"request": "launch",
	},
	{
		"label": "Django",
		"adapter": "Debugpy",
		"request": "launch",
		"program": "manage.py",
		"args": ["runserver"],
		"django": true,
	},

	{
		"label": "Worker: Django",
		"adapter": "Debugpy",
		"request": "launch",
		"program": "manage.py",
		"args": ["db_worker", "--queue-name", "scan,probe,transcode"],
		"django": true,
	},
]
